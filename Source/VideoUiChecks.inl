    int runVideoUiCheck(const File& folder,const File& demo){
        folder.createDirectory();stopTimer();loadSession(demo);engine.prepare(48000,256);timerCallback();
        auto* result=new DynamicObject();int failures=0;auto check=[&](bool passed,const char* name){result->setProperty(name,passed);if(!passed)++failures;};
        auto same=[](const VideoRecorder::Config& a,const VideoRecorder::Config& b){return a.cameraId==b.cameraId&&a.preferredWidth==b.preferredWidth&&a.preferredHeight==b.preferredHeight&&std::abs(a.preferredFps-b.preferredFps)<.0001&&a.strictFormat==b.strictFormat&&a.bitrateMbps==b.bitrateMbps&&a.rateControl==b.rateControl&&a.quality==b.quality&&a.profile==b.profile&&a.encoder==b.encoder&&a.keyframeSeconds==b.keyframeSeconds&&a.audioBitrateKbps==b.audioBitrateKbps&&a.videoDelayMs==b.videoDelayMs;};
        auto snapshot=[&](Component& component,const String& name){PNGImageFormat png;FileOutputStream stream(folder.getChildFile(name));stream.setPosition(0);stream.truncate();return png.writeImageToStream(component.createComponentSnapshot(component.getLocalBounds()),stream);};
        check(devices.getCurrentAudioDevice()==nullptr&&!cameraPreview.isBusy()&&!engine.movie.isBusy(),"noPhysicalDevicesOpened");
        int startCalls=0,settingsCalls=0;VideoRecorder::Config requested;
        CameraPanel cameraSettings(cameraPreview,[&](VideoRecorder::Config config){requested=config;++startCalls;},[]{},[&]{return folder;},false,false);cameraSettings.setLookAndFeel(&theme);cameraSettings.settingsChanged=[&](VideoRecorder::Config){++settingsCalls;};
        auto defaults=cameraSettings.requestedConfig();check(defaults.preferredWidth==1920&&defaults.preferredHeight==1080&&defaults.preferredFps==30&&defaults.bitrateMbps==12&&defaults.strictFormat&&cameraSettings.testPresetSelection()==3,"defaultIs1080p30At12MbpsWithStrictFormat");
        check(cameraSettings.getWidth()==900&&cameraSettings.getHeight()==640&&snapshot(cameraSettings,jp("カメラ付き録画・高画質設定.png")),"cameraHighQualityDefaultScreenshotWritten");
        cameraSettings.testPreset(1);auto light=cameraSettings.requestedConfig();check(light.preferredWidth==640&&light.preferredHeight==480&&light.bitrateMbps==3,"lightweightPresetApplies480pAt3Mbps");
        cameraSettings.testPreset(2);auto standard=cameraSettings.requestedConfig();check(standard.preferredWidth==1280&&standard.preferredHeight==720&&standard.bitrateMbps==6,"standardPresetApplies720pAt6Mbps");
        cameraSettings.testPreset(4);auto highest=cameraSettings.requestedConfig();check(highest.preferredWidth==3840&&highest.preferredHeight==2160&&highest.bitrateMbps==45&&highest.audioBitrateKbps==192,"highestPresetRequests4kAt45MbpsWithoutActivatingCamera");
        check(!cameraPreview.isBusy()&&startCalls==0,"editingPresetsDoesNotActivateCameraOrStartRecording");
        check(cameraSettings.testCustomControls(),"customControlsSetResolutionFpsBitrateProfileEncoderGopAudioAndSync");
        check(cameraSettings.testRateControls(),"rateControlEnablesOnlyRelevantBitrateOrQualityValue");
        check(settingsCalls>=8,"settingsChangedCallbackReceivesRealControlChanges");
        auto custom=cameraSettings.requestedConfig();String error;auto preferences=folder.getChildFile("video-settings-test.json");check(writeVideoPreferences(preferences,custom,error)&&same(readVideoPreferences(preferences),custom),"customSettingsPersistAndReloadThroughProductionPreferences");
        CameraPanel restored(cameraPreview,[](VideoRecorder::Config){},[]{},[&]{return folder;},false,false,readVideoPreferences(preferences));restored.setLookAndFeel(&theme);check(same(restored.requestedConfig(),custom)&&restored.testPresetSelection()==5,"reopenedPanelRestoresAllCustomFieldsAndCustomPreset");restored.setLookAndFeel(nullptr);
        auto invalid=custom;invalid.bitrateMbps=101;check(!writeVideoPreferences(preferences,invalid,error)&&same(readVideoPreferences(preferences),custom),"invalidSettingsDoNotOverwritePreviousPreferences");
        preferences.replaceWithText("{ broken preferences");auto recovered=readVideoPreferences(preferences);check(recovered.preferredWidth==1920&&recovered.preferredHeight==1080&&recovered.bitrateMbps==12,"malformedPreferencesFallBackToHighQualityDefaults");
        cameraSettings.testSimulateBusy(true);auto before=cameraSettings.requestedConfig();cameraSettings.testPreset(1);bool refused=!cameraSettings.setRequestedConfig(defaults);check(refused&&cameraSettings.testControlsLocked()&&same(before,cameraSettings.requestedConfig()),"activePreviewLocksAllSettingsAndRejectsProgrammaticChanges");cameraSettings.testSimulateBusy(false);
        cameraSettings.testStagePendingRequest();cameraSettings.testPreset(2);check(cameraSettings.testControlsLocked()&&same(cameraSettings.requestedConfig(),custom),"pendingRecordingKeepsControlsLockedAndRequestedSettingsUnchanged");cameraSettings.testCompletePendingRequest();check(startCalls==1&&same(requested,custom),"recordingTransitionUsesFrozenRequestedConfig");
        check(cameraSettings.testResets(),"doubleClickResetsBitrateQualityGopAndSyncValues");
        check(cameraSettings.testLayoutChecks(),"settingsFitMinimumAndExpandedWindowsWithScrollableDetails");cameraSettings.testSetDetails(true);check(snapshot(cameraSettings,jp("カメラ付き録画・詳細設定上部.png")),"cameraAdvancedTopScreenshotWritten");cameraSettings.testScrollDetailsToBottom();check(snapshot(cameraSettings,jp("カメラ付き録画・詳細設定下部.png")),"cameraAdvancedBottomScreenshotWritten");cameraSettings.setLookAndFeel(nullptr);
        CameraPanel silent(cameraPreview,[](VideoRecorder::Config){},[]{},[&]{return folder;},true,false);check(silent.testSilent(),"silentPreviewCannotActivateCameraOrRecord");
        bool fits=true;setSize(1120,700);for(int page=0;page<5;++page){mappingPage=page==4;mixerPage=page==1;effectsPage=page==2;pianoPage=page==3;updatePage();fits&=recordButton.isVisible()&&recordButton.getBottom()<playTab.getY()&&recordButton.getRight()<=getWidth()-24;}
        check(fits,"recordingMenuRemainsVisibleOnFiveScreens");mixerPage=mappingPage=effectsPage=pianoPage=false;updatePage();timerCallback();check(recordButton.getButtonText().contains(jp("▾")),"cameraModeHasVisibleMenuAffordance");check(!cameraPreview.isBusy()&&!engine.movie.isBusy()&&devices.getCurrentAudioDevice()==nullptr,"uiValidationCompletesWithoutPhysicalCameraOrAudio");
        result->setProperty("failures",failures);folder.getChildFile("video-ui-tests.json").replaceWithText(JSON::toString(var(result)));dirty=false;return failures?1:0;
    }
