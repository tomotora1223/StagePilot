int runKeyboardCheck(const File& folder,const File& demo){
    folder.createDirectory();stopTimer();loadSession(demo);engine.prepare(48000,64);combinationBank=true;setSize(1180,900);updatePage();
    Array<var> checks;int failures=0;auto check=[&](bool ok,const char* name){auto* item=new DynamicObject();item->setProperty("test",name);item->setProperty("passed",ok);checks.add(var(item));if(!ok)++failures;};
    AudioBuffer<float> buffer(2,64);auto tick=[&]{engine.render(buffer.getArrayOfWritePointers(),2,64);timerCallback();liveView.refreshKeys();};
    auto snapshot=[&](String name){timerCallback();FileOutputStream out(folder.getChildFile(name));out.setPosition(0);out.truncate();PNGImageFormat png;return png.writeImageToStream(createComponentSnapshot(getLocalBounds()),out);};
    KeyGeometry geometry;auto sample=[&](PlayableKeyboard& keyboard,int note,float height){auto r=geometry.keyBounds(note,keyboard.getLocalBounds().toFloat());auto image=keyboard.testImage();return image.getPixelAt((int)r.getCentreX(),(int)(r.getY()+r.getHeight()*height));};
    auto& keyboard=liveView.testKeyboard();engine.control(SelectScene,0);tick();
    check(devices.getCurrentAudioDevice()==nullptr,"UI opens no physical audio device");
    check(keyboard.testLayerMask(60)==3,"Two enabled overlapping sources appear on the input keyboard");
    auto before=sample(keyboard,60,.7f);check(before!=Colour(0xffe3eaf0)&&before.getBrightness()>.65f,"Idle white key has a subtle source tint with readable contrast");
    auto stripes=[&](int note){auto image=keyboard.testImage();auto r=geometry.keyBounds(note,keyboard.getLocalBounds().toFloat());auto first=image.getPixelAt((int)r.getCentreX(),(int)r.getBottom()-8);auto second=image.getPixelAt((int)r.getCentreX(),(int)r.getBottom()-5);return first.getGreen()>first.getRed()&&second.getRed()>second.getGreen();};
    check(stripes(60)&&stripes(61),"Overlapping source colours remain distinct on white and black key surfaces");
    liveView.testPressKey(60);check(keyboard.testHighlighted(60,false),"Mouse press highlights a white key before an audio buffer is processed");tick();
    check(engine.previewKey==60&&keyboard.pressedLabel().contains("C4"),"White-key audition and pressed-note label agree with the engine");
    liveView.testPressKey(61,true,true);check(keyboard.testHighlighted(61,false),"Dragging onto a black key highlights it immediately");tick();
    check(engine.previewKey==61&&keyboard.pressedLabel().contains("C#4"),"Black-key audition updates the note label and engine pitch");
    check(snapshot(jp("鍵盤・黒鍵の試聴.png")),"Black-key screenshot written");liveView.releaseKey();tick();
    check(!keyboard.testHighlighted(61,false)&&keyboard.pressedLabel()==jp("押下なし"),"Mouse release removes the pressed state and restores the source overlay");
    liveView.testPressKey(60);keyboard.refresh();liveView.releaseKey();tick();check(engine.previewKey<0&&!keyboard.testHighlighted(60,false),"Releasing before the queued preview is rendered still sends note-off");
    engine.midi(0x90,60,100);engine.midi(0x90,61,100);engine.midi(0x90,67,100);tick();
    check(keyboard.testHighlighted(60,true)&&keyboard.testHighlighted(61,true)&&keyboard.testHighlighted(67,true),"MIDI chord highlights all white and black input keys");
    check(keyboard.pressedLabel().contains("C4")&&keyboard.pressedLabel().contains("C#4")&&keyboard.pressedLabel().contains("G4"),"Pressed-note label lists a MIDI chord");
    check(keyboard.pressedLabel()==jp("押下中  C4 · C#4 · G4"),"Chord note separators remain correctly encoded Japanese UI text");
    check(snapshot(jp("鍵盤・演奏の和音.png")),"Chord screenshot written");
    engine.midi(0x91,60,100);engine.midi(0x80,60,0);tick();check(keyboard.testHighlighted(60,true),"A note remains highlighted while another MIDI channel holds it");
    engine.midi(0x81,60,0);engine.midi(0x90,61,0);tick();check(!keyboard.testHighlighted(60,true)&&!keyboard.testHighlighted(61,true)&&keyboard.testHighlighted(67,true),"Channel note-off and zero-velocity note-on clear only released keys");
    engine.midi(0xb0,64,127);engine.midi(0x80,67,0);tick();check(engine.pedalDown&&keyboard.pressedLabel()==jp("押下なし"),"Pedal sustain does not leave a physically released key highlighted");engine.control(Panic);tick();
    engine.control(SelectScene,1);tick();check(keyboard.testLayerMask(59)==3&&keyboard.testLayerMask(60)==12,"Split boundary switches source overlays exactly at C4");
    check(sample(keyboard,48,.7f)!=sample(keyboard,72,.7f),"Low and high split ranges have different visible surface colours");
    check(snapshot(jp("鍵盤・スプリットと重ね.png")),"Split screenshot written");
    mixerPage=true;updatePage();mixer.sync();auto& editingKeys=mixer.testKeyboard();
    check(editingKeys.testLayerMask(59)==3&&editingKeys.testLayerMask(60)==12,"Builder keyboard shows the selected scene's source ranges");
    mixer.inspectSource(1);mixer.testEditPart({48,72,12,.35f,true,true,true});
    check(editingKeys.testLayerMask(60)==14&&editingKeys.testLayerMask(47)==1,"Editing an overlapping range changes the builder overlay before rendering");tick();
    check(editingKeys.testLayerMask(72)==14&&editingKeys.testLayerMask(73)==12,"Transpose leaves overlays aligned to original input range boundaries");
    mixer.testPressKey(61,true);check(editingKeys.testHighlighted(61,false),"Builder black key highlights immediately");tick();
    check(snapshot(jp("鍵盤・音色作成.png")),"Builder overlap screenshot written");
    engine.control(Panic);tick();editingKeys.refresh();check(!editingKeys.testHighlighted(61,false),"Panic clears a held mouse preview highlight after the engine stops it");mixer.releaseKey();tick();
    setSize(1120,700);editViewport.setViewPosition(0,608);check(snapshot(jp("鍵盤・小画面で音色作成.png")),"Low-window builder screenshot written");
    check(editingKeys.getHeight()>=80&&editViewport.getViewPositionY()>0&&audioStrip.getBottom()<=status.getY(),"Larger builder keyboard stays reachable with fixed meters on a low window");
    mixerPage=false;updatePage();engine.midi(0x90,60,100);engine.midi(0x90,61,100);tick();
    bool narrowImage=snapshot(jp("鍵盤・1120x700.png"));check(keyboard.testHighlighted(60,true)&&keyboard.testHighlighted(61,true)&&narrowImage,"Narrow performance keyboard visibly highlights white and black input keys");engine.control(Panic);tick();
    check(keyboard.pressedLabel()==jp("押下なし"),"Panic clears the MIDI chord display");
    check(devices.getCurrentAudioDevice()==nullptr,"Audio device remains unopened after all MIDI and preview checks");
    auto* report=new DynamicObject();report->setProperty("failures",failures);report->setProperty("results",checks);report->setProperty("audioDeviceOpened",devices.getCurrentAudioDevice()!=nullptr);folder.getChildFile("keyboard-tests.json").replaceWithText(JSON::toString(var(report)));dirty=false;return failures?1:0;
}
