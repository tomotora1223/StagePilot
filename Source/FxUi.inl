    TextButton fxButton{jp("FX…")};
    std::unique_ptr<FloatingWindow> fxWindow,fxEditor;
    int scanFxTarget=-1;
    FxChain& chain(int target){return target==8?engine.masterFx:engine.slots[(size_t)target].fx;}
    FxPanel* fxPanel(){return fxWindow?dynamic_cast<FxPanel*>(fxWindow->getContentComponent()):nullptr;}
    void refreshFx(){if(auto* panel=fxPanel())panel->refresh();}
    void openFxEditor(int target,int index){if(busy)return;auto& fx=chain(target);if(index<0||index>=fxCapacity||!fx.nodes[(size_t)index].plugin)return;fxEditor.reset();auto* plugin=fx.nodes[(size_t)index].plugin.get();auto* content=plugin->createEditorAndMakeActive();if(!content)content=new GenericAudioProcessorEditor(*plugin);fxEditor=std::make_unique<FloatingWindow>(plugin->getName(),content);fxEditor->close=[safe=Component::SafePointer<Main>(this)]{MessageManager::callAsync([safe]{if(safe)safe->fxEditor.reset();});};changed();}
    void insertFx(int target,std::unique_ptr<AudioPluginInstance> plugin,const PluginDescription& description){if(!plugin)return;auto error=FxChain::configureStereo(*plugin);if(error.isNotEmpty()){inform(error);return;}bool added=false;suspend([&]{auto& fx=chain(target);int index=fx.count();if(index>=fxCapacity)return;auto& node=fx.nodes[(size_t)index];node.plugin=std::move(plugin);node.description=description;node.bypassed=false;fx.prepare(engine.rate.load(),engine.blockSize.load());added=true;});if(added){changed();refreshFx();inform(jp("FXを追加しました：")+description.name);}else inform(jp("FXは1か所につき4段までです。"));}
    void addBuiltinFx(int target){if(!editable())return;auto plugin=makeTestFx();PluginDescription description;plugin->fillInPluginDescription(description);insertFx(target,std::move(plugin),description);}
    void scanFx(const File& file,int target){if(!editable())return;if(chain(target).count()>=fxCapacity){inform(jp("FXは4段までです。"));return;}auto error=checkPluginFile(file);if(error.isNotEmpty()){inform(error);return;}busy=true;scanFxTarget=target;scanResult=File::getSpecialLocation(File::tempDirectory).getChildFile("StagePilot-fx-"+Uuid().toString()+".xml");scanner=std::make_unique<ChildProcess>();StringArray args{File::getSpecialLocation(File::currentExecutableFile).getFullPathName(),"--scan",file.getFullPathName(),scanResult.getFullPathName()};if(!scanner->start(args,0)){scanner.reset();scanFxTarget=-1;busy=false;inform(jp("FXの確認を開始できませんでした。"));return;}scanStarted=Time::getMillisecondCounter();inform(jp("FXを確認中：")+file.getFileName());}
    void finishFxScan(){int target=scanFxTarget;scanFxTarget=-1;auto xml=parseXML(scanResult);scanResult.deleteFile();scanner.reset();busy=false;if(!xml){inform(jp("FXを確認できませんでした。現在の設定はそのままです。"));return;}PluginDescription description;bool found=false;for(auto* child:xml->getChildIterator()){PluginDescription d;if(d.loadFromXml(*child)&&!d.isInstrument){description=d;found=true;break;}}if(!found){inform(jp("エフェクトが見つかりません。64bit VST2 / VST3のFXを選んでください。"));return;}busy=true;String error;auto plugin=formats.createPluginInstance(description,engine.rate.load(),engine.blockSize.load(),error);busy=false;if(!plugin){inform(jp("FXを読み込めません：")+error);return;}insertFx(target,std::move(plugin),description);}
    void chooseFx(int target){if(!editable())return;chooser=std::make_unique<FileChooser>(jp("FX（64bit VST2 / VST3）を選ぶ"),File("C:/Program Files"),"*.vst3;*.dll");chooser->launchAsync(FileBrowserComponent::openMode|FileBrowserComponent::canSelectFiles|FileBrowserComponent::canSelectDirectories,[safe=Component::SafePointer<Main>(this),target](const FileChooser& fc){if(safe&&fc.getResult().exists())safe->scanFx(fc.getResult(),target);});}
    void libraryFx(int target){if(!editable())return;if(library){library->toFront(true);return;}auto safe=Component::SafePointer<Main>(this);auto* content=new InstrumentBrowser([safe,target](File file){MessageManager::callAsync([safe,file,target]{if(!safe||!safe->editable())return;safe->library.reset();safe->scanFx(file,target);});},settingsFile().getSiblingFile("plugin-folders.txt"));content->setLookAndFeel(&theme);library=std::make_unique<FloatingWindow>(jp("FXを自動検索 — エフェクトのファイルを選択"),content);library->close=[safe]{MessageManager::callAsync([safe]{if(safe)safe->library.reset();});};}
    void fxAddMenu(int target){if(!editable())return;PopupMenu menu;menu.addItem(1,jp("インストール済みのFXから…"));menu.addItem(2,jp("VSTファイルから…"));menu.addItem(3,jp("内蔵ゲートを追加"));menu.showMenuAsync(PopupMenu::Options().withTargetComponent(fxPanel()),[safe=Component::SafePointer<Main>(this),target](int result){if(!safe||!safe->editable())return;if(result==1)safe->libraryFx(target);if(result==2)safe->chooseFx(target);if(result==3)safe->addBuiltinFx(target);});}
    void showFx(int target){if(fxWindow){if(auto* panel=fxPanel())panel->setTarget(target);fxWindow->toFront(true);return;}auto* content=new FxPanel(engine,target);content->setLocked(live);content->onAdd=[this](int t){fxAddMenu(t);};content->onOpen=[this](int t,int i){openFxEditor(t,i);};content->onRemove=[this](int t,int i){if(!editable())return;fxEditor.reset();suspend([&]{chain(t).remove(i);});changed();refreshFx();};content->onMove=[this](int t,int i,int delta){if(!editable())return;fxEditor.reset();suspend([&]{chain(t).moveNode(i,i+delta);});changed();refreshFx();};content->onBypass=[this](int t,int i,bool bypassed){if(busy)return;chain(t).nodes[(size_t)i].bypassed=bypassed;changed();refreshFx();};content->setLookAndFeel(&theme);fxWindow=std::make_unique<FloatingWindow>(jp("FX — 音源と全体出力"),content);fxWindow->setResizeLimits(760,550,1400,1000);fxWindow->close=[safe=Component::SafePointer<Main>(this)]{MessageManager::callAsync([safe]{if(safe)safe->fxWindow.reset();});};}
    void fxMenu(){PopupMenu menu;menu.addItem(1,jp("選択中の音源のFX…"));menu.addItem(2,jp("全体出力のFX…"));menu.showMenuAsync(PopupMenu::Options().withTargetComponent(&fxButton),[safe=Component::SafePointer<Main>(this)](int result){if(safe&&result>0)safe->showFx(result==2?8:juce::jlimit(0,7,safe->audioStrip.focus()));});}
    var fxJson(FxChain& fx){Array<var> values;for(auto& node:fx.nodes)if(node.plugin){auto* item=new DynamicObject();item->setProperty("description",node.description.createXml()->toString());MemoryBlock state;node.plugin->getStateInformation(state);item->setProperty("state",state.toBase64Encoding());item->setProperty("bypassed",node.bypassed.load());values.add(var(item));}return values;}
    bool readFx(const var& value,FxChain& fx,String& error){auto* values=value.getArray();if(!values||values->size()>fxCapacity){error=jp("FXの段数・形式が壊れています。");return false;}for(auto item:*values){auto xml=parseXML(item["description"].toString());PluginDescription description;if(!xml||!description.loadFromXml(*xml)){error=jp("FXの情報を読み込めません。");return false;}std::unique_ptr<AudioPluginInstance> plugin;if(description.pluginFormatName=="Internal"&&description.fileOrIdentifier=="stage:gate")plugin=makeTestFx();else plugin=formats.createPluginInstance(description,engine.rate.load(),engine.blockSize.load(),error);if(!plugin){error=description.name+": "+error;return false;}MemoryBlock state;if(!item["state"].isString()||!state.fromBase64Encoding(item["state"].toString())){error=jp("FXの設定値が壊れています。");return false;}plugin->setStateInformation(state.getData(),(int)state.getSize());error=FxChain::configureStereo(*plugin);if(error.isNotEmpty())return false;auto& node=fx.nodes[(size_t)fx.count()];node.plugin=std::move(plugin);node.description=description;node.bypassed=(bool)item.getProperty("bypassed",false);}return true;}
